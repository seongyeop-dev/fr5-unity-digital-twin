<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>FR5_CSharp_Bridge</RootNamespace>
    <AssemblyName>FR5_CSharp_Bridge</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <FairinoSdkAssembly Condition="'$(FairinoSdkAssembly)' == ''">$(FairinoSdkDir)/libfairino.dll</FairinoSdkAssembly>
    <XmlRpcAssembly Condition="'$(XmlRpcAssembly)' == ''">$(FairinoSdkDir)/CookComputing.XmlRpcV2.dll</XmlRpcAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="libfairino">
      <HintPath>$(FairinoSdkAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CookComputing.XmlRpcV2">
      <HintPath>$(XmlRpcAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireFairinoDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(FairinoSdkAssembly)')" Text="Set FairinoSdkDir or FairinoSdkAssembly to the FAIRINO .NET Framework 4.8.1 SDK library." />
    <Error Condition="!Exists('$(XmlRpcAssembly)')" Text="Set FairinoSdkDir or XmlRpcAssembly to CookComputing.XmlRpcV2.dll." />
  </Target>
</Project>
